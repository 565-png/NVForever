    "  PrintToConsole \"P2|%z|auxvar|perm=%.1f,temp=%.1f\" svTag vAvP vAvT",
    "  PrintToConsole \"P2|%z|refmap|perm=%.1f,temp=%.1f\" svTag vRmP vRmT",
