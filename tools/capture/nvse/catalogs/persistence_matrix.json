  "mutate_script_lines": [
    "ref rDocRef = GetFormFromMod \"FalloutNV.esm\" \"104C0F\"",
    "ref rDocBase = GetFormFromMod \"FalloutNV.esm\" \"104C0C\"",
    "ref rGun = GetFormFromMod \"FalloutNV.esm\" \"434F\"",
    "ref rStim = GetFormFromMod \"FalloutNV.esm\" \"15169\"",
    "ref rRec = GetFormFromMod \"FalloutNV.esm\" \"175AA9\"",
    "ref rMeat = GetFormFromMod \"FalloutNV.esm\" \"16D5BA\"",
    "ref rQuest = GetFormFromMod \"FalloutNV.esm\" \"80664\"",
    "ref rZone = GetFormFromMod \"FalloutNV.esm\" \"E9081\"",
    "ref rTerm = GetFormFromMod \"FalloutNV.esm\" \"13253C\"",
    "ref rNote = GetFormFromMod \"FalloutNV.esm\" \"14E6E2\"",
    "ref rLight = GetFormFromMod \"FalloutNV.esm\" \"695BE\"",
    "ref rGsFac = GetFormFromMod \"FalloutNV.esm\" \"104C6E\"",
    "ref rDoor = GetFormFromMod \"FalloutNV.esm\" \"103E61\"",
    "ref rPkg = GetFormFromMod \"FalloutNV.esm\" \"105BD2\"",
    "ref rBaseCap = GetFormFromMod \"FalloutNV.esm\" \"F\"",
    "; Place a non-persistent cap ref in cell & save its ref in a permanent AuxVar so we can re-find it after cold load!",
    "ref rPlaced = Player.PlaceAtMe rBaseCap 1",
    "Player.AuxVarSetRef \"w4b_placed_ref\" rPlaced",
    "; 1-2. AuxVar permanent vs temporary (*)",
    "Player.AuxVarSetFlt \"w4b_av_perm\" 123.5",
    "Player.AuxVarSetFlt \"*w4b_av_temp\" 456.5",
    "; 3-4. RefMap permanent vs temporary (*)",
    "RefMapArraySetFloat \"w4b_rm_perm\" 321.5 rDocRef",
    "RefMapArraySetFloat \"*w4b_rm_temp\" 654.5 rDocRef",
    "; 5-6. AuxStringMapArray permanent vs temporary (*)",
    "Player.AuxStringMapArraySetFloat \"w4b_asm_perm\" \"k\" 777.5",
    "Player.AuxStringMapArraySetFloat \"*w4b_asm_temp\" \"k\" 888.5",
    "; 7. SetArmorConditionPenalty (default 1.0 -> 3.5)",
    "SetArmorConditionPenalty 3.5",
    "; 8. SetWeaponSemiAutoFireDelay (default 0.0 -> 0.75)",
    "SetWeaponSemiAutoFireDelay rGun 0 0.75",
    "; 9. SetWeaponCritDamage (default 22 -> 77)",
    "SetWeaponCritDamage 77 rGun",
    "; 10. SetStageAlt (quest 80664 -> stage 20)",
    "SetStageAlt rQuest 20",
    "; 11. SetViewmodelClipDistance (default 0 -> 12.5)",
    "SetViewmodelClipDistance 12.5",
    "; 12. AddNewEffect on Stimpak (default 4 -> 5)",
    "ref rEf0 = GetNthEffectBase rStim 0",
    "AddNewEffect rStim rEf0 5 10 0 0 1",
    "; 13. SetRecipeInputCount (Gecko Steak meat default 1 -> 7)",
    "SetRecipeInputCount rRec rMeat 7",
    "; 14. HideItemBarterEx on 10mm Pistol",
    "HideItemBarterEx rGun 1 1",
    "; 15. SetCombatDisabled on Doc Mitchell (default 0 -> 1)",
    "rDocRef.SetCombatDisabled 1",
    "; 16. ToggleItemUnique on 10mm Pistol (default 0 -> 1)",
    "ToggleItemUnique rGun 1",
    "; 17. SetPersistent on rPlaced (default 0 -> 1)",
    "rPlaced.SetPersistent 1",
    "; 18. SetZoneFlag / SetZoneRespawns on Vault11Zone (0xE9081: flag 1 = NeverResets, default 1 -> 0 so respawns=1)",
    "SetZoneFlag rZone 1 0",
    "; 19. SetPasswordNote on terminal 0x13253C -> note 0x14E6E2",
    "SetPasswordNote rNote rTerm",
    "; 20. SetRadius on Light 0x695BE (default 200 -> 444)",
    "SetRadius 444 rLight",
    "; 21. SetBaseFactionRank on Doc base (0x104C0C, faction 0x104C6E -> rank 5)",
    "SetBaseFactionRank rGsFac 5 rDocBase",
    "; 22. SetOwningFactionRequiredRank on Door 0x103E61 (default 0 -> 3)",
    "rDoor.SetOwningFactionRequiredRank 3",
    "; 23. SetPackageTargetDistance on Pack 0x105BD2 (default 420 -> 250)",
    "SetPackageTargetDistance rPkg 250",
    "; 24. SetEnableParent on rPlaced -> Player",
    "rPlaced.SetEnableParent Player",
    "; 25. SetRadiationExtraData on DocRef (default 0 -> 12.5)",
    "rDocRef.SetRadiationExtraData 12.5",
    "; 26. SetActorBaseFlagsLow on DocBase (default 0 -> 2 Essential)",
    "SetActorBaseFlagsLow 2 rDocBase",
    "; 27. ToggleQuestMessages (default 1 -> 0) & FreezeAmmoRegen (default 0 -> 1)",
    "ToggleQuestMessages 0",
    "FreezeAmmoRegen 1",
    "; 28. SetEventHandler custom event survival across load",
    "Player.AuxVarSetFlt \"*w4b_evt_hit\" 0",
    "ref rEvtCb = CompileScript \"nvseprobe_s_hlp_evt.gek\"",
    "SetEventHandler \"W4BPersistEvt\" rEvtCb",
    "; Read back BEFORE save!",
    "Call (CompileScript \"nvseprobe_s_p2_readback.gek\") \"BEFORE\""
  ],
  "readback_script_lines": [
    "ref rDocRef = GetFormFromMod \"FalloutNV.esm\" \"104C0F\"",
    "ref rDocBase = GetFormFromMod \"FalloutNV.esm\" \"104C0C\"",
    "ref rGun = GetFormFromMod \"FalloutNV.esm\" \"434F\"",
    "ref rStim = GetFormFromMod \"FalloutNV.esm\" \"15169\"",
    "ref rRec = GetFormFromMod \"FalloutNV.esm\" \"175AA9\"",
    "ref rMeat = GetFormFromMod \"FalloutNV.esm\" \"16D5BA\"",
    "ref rQuest = GetFormFromMod \"FalloutNV.esm\" \"80664\"",
    "ref rZone = GetFormFromMod \"FalloutNV.esm\" \"E9081\"",
    "ref rTerm = GetFormFromMod \"FalloutNV.esm\" \"13253C\"",
    "ref rLight = GetFormFromMod \"FalloutNV.esm\" \"695BE\"",
    "ref rGsFac = GetFormFromMod \"FalloutNV.esm\" \"104C6E\"",
    "ref rDoor = GetFormFromMod \"FalloutNV.esm\" \"103E61\"",
    "ref rPkg = GetFormFromMod \"FalloutNV.esm\" \"105BD2\"",
    "ref rPlaced = Player.AuxVarGetRef \"w4b_placed_ref\"",
    "float vAvP = Player.AuxVarGetFlt \"w4b_av_perm\"",
    "float vAvT = Player.AuxVarGetFlt \"*w4b_av_temp\"",
    "float vRmP = RefMapArrayGetFloat \"w4b_rm_perm\" rDocRef",
    "float vRmT = RefMapArrayGetFloat \"*w4b_rm_temp\" rDocRef",
    "float vAsmP = Player.AuxStringMapArrayGetFloat \"w4b_asm_perm\" \"k\"",
    "float vAsmT = Player.AuxStringMapArrayGetFloat \"*w4b_asm_temp\" \"k\"",
    "float vArmPen = SetArmorConditionPenalty",
    "float vSemi = GetWeaponSemiAutoFireDelay rGun 0",
    "float vCrit = GetWeaponCritDamage rGun",
    "int vStg = GetStage rQuest",
    "int vStg20 = GetStageDone rQuest 20",
    "float vClip = GetViewmodelClipDistance",
    "int vEffN = GetNumEffects rStim",
    "int vRecC = GetRecipeInputCount rRec rMeat",
    "int vHide = IsItemBarterHiddenEx rGun",
    "int vCmbDis = rDocRef.GetCombatDisabled",
    "int vUniq = IsItemUnique rGun",
    "int vPers = -1",
    "ref rPar = 0",
    "if IsFormValid rPlaced",
    "  let vPers := rPlaced.IsPersistent",
    "  let rPar := rPlaced.GetParentRef",
    "endif",
    "int vZoneF = GetZoneFlag rZone 1",
    "int vZoneR = GetZoneRespawns rZone",
    "ref rPw = GetPasswordNote rTerm",
    "float vRadL = GetRadius rLight",
    "int vFacRk = GetBaseFactionRank rGsFac rDocBase",
    "int vOwnRk = rDoor.GetOwningFactionRequiredRank",
    "int vPkgD = GetPackageTargetDistance rPkg",
    "float vRadEx = rDocRef.GetRadiationExtraData",
    "int vFlagsL = GetActorBaseFlagsLow rDocBase",
    "int vEss = rDocRef.IsEssential",
    "int vQMsg = ToggleQuestMessages",
    "int vFrz = FreezeAmmoRegen",
    "; Dispatch custom event to check whether SetEventHandler survived!",
    "Player.AuxVarSetFlt \"*w4b_evt_hit\" 0",
    "DispatchEvent \"W4BPersistEvt\"",
    "int vEvt = Player.AuxVarGetFlt \"*w4b_evt_hit\"",
